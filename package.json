    "type": "git",
    "url": "https://github.com/beshoysabri/sn-money-month.git"
  },
  "homepage": "https://beshoysabri.github.io/sn-money-month/",
  "keywords": [
    "Standard Notes",
    "Personal Finance",
    "Editor Plugin",
    "Monthly Report"
  ],
  "license": "MIT",
  "sn": {
    "main": "dist/index.html"
  },
  "scripts": {
    "dev": "vite",
