{
  "name": "sn-money-month",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A Standard Notes editor that turns a monthly finance report into a calm, phone-first visual report: the month's verdict first, then each section as the chart that suits it.",
